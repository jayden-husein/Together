# Copy into .env. Vite exposes only VITE_* names to the browser, so the
# STAGING_* secrets that scripts/setup-staging.sh writes stay out of the bundle.
VITE_SUPABASE_URL=$STAGING_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=$STAGING_SUPABASE_PUBLISHABLE_KEY

# Demo data scripts (npm run reset-demo / access-check -- staging|production) read
# <TARGET>_SUPABASE_URL, _PUBLISHABLE_KEY and _SECRET_KEY, plus the shared demo Account password.
# PRODUCTION_SUPABASE_URL=https://ojxqgqgmtwaehtdfaxrs.supabase.co
# PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
# PRODUCTION_SUPABASE_SECRET_KEY=
DEMO_PASSWORD=
